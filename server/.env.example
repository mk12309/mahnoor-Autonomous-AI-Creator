# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/signalforge

# AI Providers
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
AI_PROVIDER=gemini

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_token
LINKEDIN_PERSON_URN=your_urn

# Pipeline
DISCOVERY_CRON=0 */4 * * *
PIPELINE_CRON=0 */6 * * *
RELEVANCE_THRESHOLD=70
AUTO_APPROVE=false

# RSS Feeds (comma-separated)
RSS_FEEDS=https://hnrss.org/newest?q=AI,https://techcrunch.com/feed/,https://feeds.feedburner.com/TheHackersNews
