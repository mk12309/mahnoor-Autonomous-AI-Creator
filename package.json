{
  "name": "signalforge-ai",
  "version": "1.0.0",
  "description": "Autonomous AI Infrastructure Analyst — Discovers live topics, evaluates technical value, generates structured compute briefs, and publishes autonomously.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "cd backend && npm start",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "cd backend && npm install && cd ../client && npm install"
  },
  "keywords": [
    "ai",
    "autonomous",
    "breeth-ai",
    "infrastructure",
    "signalforge",
    "hackathon"
  ],
  "author": "SignalForge AI Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "mongoose": "^8.24.2",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
