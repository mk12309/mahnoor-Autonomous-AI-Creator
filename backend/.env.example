# Application Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.brwqxgk.mongodb.net/signalforge_db?retryWrites=true&w=majority

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Autonomous Agent Scheduler Configuration
PUBLISH_INTERVAL_MINUTES=30
AGENT_CRON_INTERVAL="*/30 * * * *"
RELEVANCE_THRESHOLD=70

# Breeth Persistent Memory Layer (https://docs.thebreeth.com)
# API key from Breeth dashboard — must start with ck_live_
# Write endpoint:  POST https://api.thebreeth.com/v1/episodes
# Search endpoint: POST https://api.thebreeth.com/v1/search
BREETH_API_KEY=ck_live_your_key_here
BREETH_BASE_URL=https://api.thebreeth.com
